def time_input(message: Message):
    global time
    try:
        dt_object = datetime.datetime.strptime(f'2025-{month}-{day} {message.text}', '%Y-%m-%d %H:%M')
    except ValueError:
        bot.send_message(message.chat.id,f'Вы введи время неправильно, введите час, минуты (в формате 9:41) когда напоминание должно прийти')
        bot.register_next_step_handler(message, time_input)
        return
    if dt_object:
        time = int(dt_object.timestamp())
        bot.send_message(message.chat.id, 'Введите текст заметки')
        bot.register_next_step_handler(message, note_text)
    else:
        bot.send_message(message.chat.id, f'Введите правильное значение (в формате 9:41)')
        bot.register_next_step_handler(message, time_input)


