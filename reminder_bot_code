def data_convert(time):
    new_time = datetime.datetime.fromtimestamp(time).strftime('%Y-%m-%d %H:%M')
    return new_time



def check_data():
    date_day = datetime.datetime.now().day
    date_month = datetime.datetime.now().month
    date_year = datetime.datetime.now().year
    return date_day, date_month, date_year







